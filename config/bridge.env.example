# Copy to config/bridge.env and fill in your own device credentials.
# Do NOT commit config/bridge.env.

# ---- Robot credentials (extracted once from the ROLA app) ----
EBO_LICENSE=
EBO_UID=
EBO_AUTHKEY=
EBO_IDENTITY=
EBO_TOKEN=

# ---- Stream auth (mediamtx RTSP/WebRTC/HLS) ----
EBO_STREAM_USER=ebo
EBO_STREAM_PASS=change-me-rtsp

# ---- Web panel & HTTP API auth (leave EBO_WEB_USER empty to disable) ----
EBO_WEB_USER=ebo
EBO_WEB_PASS=change-me-web

# ---- Bind address & display name ----
EBO_BIND=0.0.0.0
EBO_PORT=8000
EBO_NAME=EBO-SE

# ---- Optional MQTT broker ----
EBO_MQTT_HOST=
EBO_MQTT_PORT=1883
EBO_MQTT_USER=
EBO_MQTT_PASS=
